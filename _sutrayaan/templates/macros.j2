{% macro audit_form(type="Free website audit") %}
<form class="card" id="auditForm" data-type="{{ type }}" novalidate>
  <div class="fields">
    <label>Your name *<input id="a_name" autocomplete="name"><span class="err" data-for="a_name" hidden></span></label>
    <label>Company name *<input id="a_company" autocomplete="organization"><span class="err" data-for="a_company" hidden></span></label>
    <label>Phone / WhatsApp<input id="a_phone" type="tel" autocomplete="tel" placeholder="+91 98200 12345"><span class="err" data-for="a_phone" hidden></span></label>
    <label>Work email<input id="a_email" type="email" autocomplete="email"><span class="err" data-for="a_email" hidden></span></label>
    <label class="full">Current website <span class="small" style="font-weight:400">(leave blank if you don't have one)</span><input id="a_site" placeholder="www.yourcompany.com"></label>
    <label>What do you make?<select id="a_ind"><option>CNC and engineering</option><option>Plastics</option><option>Chemicals</option><option>Packaging</option><option>Other</option></select></label>
    <label>Biggest problem today<select id="a_prob"><option>Too few enquiries</option><option>Slow replies</option><option>Site looks outdated</option><option>No website yet</option><option>Other</option></select></label>
    <div aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden"><label>Website<input id="a_web" tabindex="-1" autocomplete="off"></label></div>
  </div>
  <p class="err" id="aErr" hidden></p>
  <div class="row" style="align-items:center"><button class="btn btn-primary" type="submit" id="aBtn">Send my audit request</button><span class="small">Or WhatsApp +91 99675 55168</span></div>
</form>
<div class="done" id="aDone" hidden>
  <span class="eyebrow"><i class="knot"></i>Request received</span>
  <h3 style="font:400 2rem/1.1 var(--f-display)">Thank you. Your reference is <b class="ref" id="aRef"></b></h3>
  <p class="muted">We'll send your audit within 24 hours. For anything urgent, WhatsApp us on +91 99675 55168.</p>
</div>
{% endmacro %}

{% macro mini(d, w=1000) %}
<div class="mini"><img src="https://images.unsplash.com/photo-{{ d.img }}?auto=format&fit=crop&w={{ w }}&q=70" srcset="https://images.unsplash.com/photo-{{ d.img }}?auto=format&fit=crop&w=640&q=70 640w, https://images.unsplash.com/photo-{{ d.img }}?auto=format&fit=crop&w=1000&q=70 1000w, https://images.unsplash.com/photo-{{ d.img }}?auto=format&fit=crop&w=1400&q=70 1400w" sizes="(max-width:820px) 100vw, 600px" alt="" loading="lazy" width="1000" height="625">
  <div class="bar"><i></i><i></i><i></i><span>{{ d.host }}</span></div>
  <div class="copy"><small>{{ d.kicker }}</small><strong>{{ d.headline }}</strong><em style="background:{{ d.btn_bg }};color:{{ d.btn_ink }}">{{ d.cta }}</em></div></div>
{% endmacro %}

{% macro eyebrow(text, knot=True) %}<span class="eyebrow"{% if knot %} data-knot{% endif %}><i class="knot"></i>{{ text }}</span>{% endmacro %}

{% macro cta_band(title, sub, btn="Get a free website audit", href="/audit/") %}
<section class="dark">
  <div class="wrap" style="display:grid;gap:24px;justify-items:start">
    {{ eyebrow("Next step") }}
    <h2>{{ title|safe }}</h2>
    <p class="muted">{{ sub }}</p>
    <div class="row"><a class="btn btn-saffron" href="{{ href }}">{{ btn }}</a><a class="btn btn-ghost" href="/contact/">Talk to us</a></div>
  </div>
</section>
{% endmacro %}
