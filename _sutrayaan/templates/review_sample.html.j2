{% extends "base.html.j2" %}
{% import "macros.j2" as M %}
{% set stages = [
  ("Enquiry", "Website, IndiaMART, email, calls, exhibitions", "Five inboxes and two phones. No single list.", "break"),
  ("Quote", "Excel template, emailed as PDF", "4.2 days on average. Prices typed by hand.", "slip"),
  ("Follow-up", "Salesperson's memory", "Only 38% of quotes get a second call.", "break"),
  ("Order", "PO by email, entered in Tally", "Specs re-typed. 9 orders changed after PO.", "slip"),
  ("Production plan", "Whiteboard and WhatsApp group", "Works, but sales can't see it.", "ok"),
  ("Dispatch", "Register and Tally", "Export documents prepared on time.", "ok"),
  ("Payment", "Tally, chased by accounts", "Sales not told about overdue buyers.", "slip"),
] %}
{% set findings = [
  ("Enquiries arrive in five places", "214 enquiries in three months: website form, IndiaMART, two Gmail inboxes, and calls. 31 had no reply recorded anywhere.", "About 15% of enquiries may never get a quote.", "High"),
  ("Quotes take four days", "Each quote is built by copying an old Excel file. Export prices are converted by hand. The sales head approves on WhatsApp.", "Buyers who asked three suppliers often decide before you reply.", "High"),
  ("No follow-up system", "62% of quotes sent in July–September got no second contact. Follow-ups depend on each salesperson.", "Orders lost quietly, with no reason recorded.", "High"),
  ("Order details typed twice", "The PO is re-typed into Tally and again into the job card. 9 of 29 orders had a spec or quantity mismatch.", "Rework, and delays on export shipments.", "Medium"),
  ("Owner sees numbers late", "Monthly sales figures come from accounts after the month ends. There is no view of open quotes.", "Decisions on pricing and hiring are made on gut feel.", "Medium"),
  ("Dealers handled like direct buyers", "Four dealers get the same quote format as end buyers, with discounts worked out each time.", "Inconsistent dealer prices.", "Low"),
] %}
{% block content %}
  <section class="page-hero report-hero">
    <div class="wrap">
      {{ M.eyebrow("Sample process review") }}
      <h1>See where orders slip, <em>before you buy software.</em></h1>
      <p class="lede">A full example of our paid process review for growing manufacturers. The company below is fictional; the structure is what you get.</p>
      <div class="row no-print"><a class="btn btn-primary" href="/contact/">Ask about a review</a><button class="btn btn-ghost" type="button" onclick="window.print()">Save as PDF</button></div>
    </div>
  </section>

  <section class="tight">
    <div class="wrap">
      <article class="report" aria-label="Sample process review report">
        <header class="r-head">
          <div class="r-brand">
            <svg width="30" height="30" viewBox="0 0 40 40" aria-hidden="true"><rect width="40" height="40" rx="10" fill="var(--ink)"/><path d="M7 29c6-16 22-18 18-6s-14 8-4-4 13-9 13-9" fill="none" stroke="var(--saffron)" stroke-width="2.6" stroke-linecap="round"/><circle cx="7" cy="29" r="3" fill="var(--saffron)"/></svg>
            <b>SUTRAYAAN</b><span>Process review</span>
          </div>
          <dl class="r-meta">
            <div><dt>Prepared for</dt><dd>Example Flow Components, Vasai <span class="tagline">Fictional sample</span></dd></div>
            <div><dt>Business</dt><dd>Valve and fitting parts · 65 people · about 40% exports</dd></div>
            <div><dt>Who we spoke to</dt><dd>Owner, sales head, 2 sales staff, export coordinator, production planner, accounts</dd></div>
            <div><dt>Reference</dt><dd>PR-SAMPLE · records for Jul–Sep 2026</dd></div>
          </dl>
        </header>

        <div class="r-sec">
          <h2 class="r-h">Summary</h2>
          <p class="r-lead">Your factory makes and ships well. The trouble is before the order: enquiries are scattered, quotes are slow, and most quotes are never followed up. Fix those three, and the same team can win more of the enquiries you already get. Software helps only after the process is clear.</p>
          <div class="pr-kpis">
            <div><b>214</b><span>enquiries in 3 months</span></div>
            <div><b>61%</b><span>got a quote</span></div>
            <div><b>4.2 days</b><span>average time to quote</span></div>
            <div><b>38%</b><span>of quotes followed up</span></div>
            <div><b>29</b><span>orders won</span></div>
          </div>
        </div>

        <div class="r-sec">
          <h2 class="r-h">How an order moves today</h2>
          <ol class="pr-flow">
            {% for name, tool, note, st in stages %}
            <li class="{{ st }}"><span class="pr-st">{{ {"ok":"Working","slip":"Slipping","break":"Broken"}[st] }}</span><b>{{ name }}</b><em>{{ tool }}</em><p>{{ note }}</p></li>
            {% endfor %}
          </ol>
        </div>

        <div class="r-sec">
          <h2 class="r-h">Where things slip</h2>
          <table class="r-table pr-table">
            <thead><tr><th>Finding</th><th>What we found</th><th>What it costs you</th><th>Priority</th></tr></thead>
            <tbody>
            {% for t, f, c, p in findings %}
              <tr><td><b>{{ t }}</b></td><td>{{ f }}</td><td>{{ c }}</td><td><span class="r-pill {{ {'High':'fail','Medium':'partial','Low':'pass'}[p] }}">{{ p }}</span></td></tr>
            {% endfor %}
            </tbody>
          </table>
        </div>

        <div class="r-sec">
          <h2 class="r-h">What we recommend</h2>
          <ol class="r-fixes">
            <li><div class="r-fix-n">1</div><div class="r-fix-body"><h3>Agree the process first</h3>
              <p><b>Rules.</b> One owner for every enquiry within 2 hours. Quotes out in 24 hours for standard parts and 3 days for drawings. A follow-up on day 3 and day 10 after each quote. A reason recorded for every lost quote.</p>
              <p><b>Price list.</b> One approved price list for direct buyers, one for dealers, and export prices in USD and EUR, updated each quarter.</p></div>
              <dl class="r-fix-meta"><div><dt>Cost</dt><dd>Your time</dd></div><div><dt>Time</dt><dd>1 week</dd></div></dl></li>
            <li><div class="r-fix-n">2</div><div class="r-fix-body"><h3>Put sales on Zoho CRM</h3>
              <p><b>What it covers.</b> All enquiries in one place, with website and IndiaMART leads coming in automatically. Quotes built from the price list, with approval by the sales head. Follow-up tasks created for every quote. Separate pipelines for direct, dealer and export buyers.</p>
              <p><b>For the owner.</b> A dashboard of open quotes, win rate and expected orders, plus a Monday email report.</p></div>
              <dl class="r-fix-meta"><div><dt>Users</dt><dd>6</dd></div><div><dt>Time</dt><dd>5 weeks</dd></div></dl></li>
            <li><div class="r-fix-n">3</div><div class="r-fix-body"><h3>Stop re-typing orders</h3>
              <p><b>What we'd do.</b> Won deals create a clean order sheet with the agreed specs, shared with production and accounts. Keep Tally for accounts for now.</p>
              <p><b>Not yet.</b> A full ERP or Zoho One is not needed at your size today. Revisit in 12 months, once the CRM is in daily use.</p></div>
              <dl class="r-fix-meta"><div><dt>Impact</dt><dd>Medium</dd></div><div><dt>Time</dt><dd>1 week</dd></div></dl></li>
          </ol>
        </div>

        <div class="r-sec r-quote">
          <div>
            <h2 class="r-h">Fixed quote</h2>
            <p>Recommendations 2 and 3, with training for six people and 60 days of support. The Zoho CRM licence is billed by Zoho to your company, from about ₹57,600 a year for six users.</p>
            <p class="small">The ₹15,000 review fee is already deducted.</p>
          </div>
          <div class="r-price"><span>Zoho CRM setup</span><b>₹95,000</b><span>Ready in 6 weeks · plus GST</span></div>
        </div>

        <div class="r-foot">
          <span>Prepared by Sutrayaan · rohan@sutrayaan.com · WhatsApp +91 99675 55168</span>
          <span>This quote is valid for 30 days. No obligation.</span>
        </div>
      </article>
      <p class="small no-print" style="margin-top:18px">Sample only. Example Flow Components and its numbers are fictional. Your review is based on your own records and team.</p>
    </div>
  </section>

{{ M.cta_band("Want to see where <em>your orders slip?</em>", "Tell us about your team and how enquiries reach you. We'll reply within 24 hours with a fixed price for the review.", btn="Ask about a review", href="/contact/") }}
{% endblock %}
